        <mxCell id="K2XeesM7SyxH3Unlim4T-18" value="состояние - изменения организма, возникающие в связи с воздействием патогенных и (или) физиологических факторов и требующие оказания медицинской помощи;" style="text;whiteSpace=wrap;html=1;fontColor=#000000;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="175" y="510" width="560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="K2XeesM7SyxH3Unlim4T-19" value="" style="sketch=0;points=[[0.015,0.015,0],[0.985,0.015,0],[0.985,0.985,0],[0.015,0.985,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];verticalLabelPosition=bottom;html=1;verticalAlign=top;aspect=fixed;align=center;pointerEvents=1;shape=mxgraph.cisco19.rect;prIcon=monitor;fillColor=#FAFAFA;strokeColor=#005073;fontColor=#FFFFFF;" vertex="1" parent="1">
